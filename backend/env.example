# API Configuration
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=524288000  # 500MB in bytes

# CORS (comma-separated list of origins, or * for all)
BACKEND_CORS_ORIGINS=["*"]

# Model Configuration
MODEL_PATH=./models/3d_cnn_tr_model.pth
CONFIDENCE_THRESHOLD=0.8

# Uncomment and configure if using Redis for task queue
# REDIS_URL=redis://redis:6379/0

# Uncomment and configure if using MinIO for file storage
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_SECURE=False
# MINIO_BUCKET_NAME=aneurysm-scans
